{
  "type": "module",
  "devDependencies": {
    "@types/papaparse": "^5.3.7",
    "@types/subset-font": "^2.3.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "gray-matter": "^4.0.3",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-merge-cells": "https://github.com/xiupos/markdown-it-merge-cells.git#master",
    "papaparse": "^5.4.1",
    "prettier": "^3.8.4",
    "sass": "^1.63.6",
    "subset-font": "^2.1.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.61.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.35"
  },
  "scripts": {
    "dev": "bun run build:font-dry && bun run dev:vp",
    "build": "bun run build:font && bun run build:vp",
    "eject": "vitepress eject src",
    "lint": "bun run lint:ts",
    "fix": "bun run fix:ts",
    "dev:vp": "vitepress dev src",
    "build-dry": "bun run build:font-dry && bun run build:vp",
    "build:font": "bun run util:font subset src",
    "build:font-dry": "bun run util:font subset-dry src",
    "build:vp": "vitepress build src",
    "util:font": "bun run src/.vitepress/scripts/font.ts",
    "lint:ts": "eslint src",
    "fix:ts": "eslint --fix src"
  }
}
